# WhatsApp Bot Server Environment Variables
# Copy this file to .env and fill in the values

# Server Configuration
PORT=5600
NODE_ENV=development

# MongoDB Atlas Connection (Required)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/akshyaportal?retryWrites=true&w=majority

# Twilio Configuration (Required for WhatsApp)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# API Endpoints (Set these after deployment)
CHAT_API_BASE=https://your-chat-api.onrender.com
DOCUMENT_SERVICE_API_BASE=https://your-portal.onrender.com

# Host Configuration (for production)
HOST=localhost
HTTPS=false
